{
  "name": "@cefari/cli",
  "version": "0.1.0",
  "description": "Cefari TypeScript developer CLI",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "bin": {
    "cefari": "dist/bin/cefari.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/bin",
    "dist/src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "dependencies": {
    "cmd-ts": "^0.15.0",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}

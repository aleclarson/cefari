{
  "name": "cefari",
  "version": "0.1.0",
  "description": "Cefari Deno-first developer CLI",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "bin": {
    "cefari": "dist/bin/cefari.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./app": {
      "types": "./dist/app/mod.d.ts",
      "import": "./dist/app/mod.js"
    },
    "./ipc": {
      "types": "./dist/app/ipc.d.ts",
      "import": "./dist/app/ipc.js"
    },
    "./daemon": {
      "types": "./dist/src/daemon.d.ts",
      "import": "./dist/src/daemon.js"
    },
    "./logs": {
      "types": "./dist/src/logs.d.ts",
      "import": "./dist/src/logs.js"
    },
    "./worker": {
      "types": "./dist/src/worker.d.ts",
      "import": "./dist/src/worker.js"
    }
  },
  "files": [
    "dist/app",
    "dist/bin",
    "dist/src",
    "deno.json",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit && deno check src/app/mod.ts tests/app/cefari_app_test.ts",
    "test": "pnpm build && node --test dist/tests/*.test.js && deno test -A tests/app",
    "bin:install": "deno install --config deno.json -f -g -n cefari --allow-all ./dist/bin/cefari.js"
  },
  "dependencies": {
    "cmd-ts": "^0.15.0",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}

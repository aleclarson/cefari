{
  "name": "cefari",
  "version": "0.0.0",
  "private": true,
  "description": "Cefari developer CLI",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cefari/cefari.git"
  },
  "bin": {
    "cefari": "bin/cefari.js"
  },
  "exports": {
    ".": {
      "types": "./config/index.d.ts",
      "import": "./config/index.mjs",
      "require": "./config/index.cjs",
      "default": "./config/index.mjs"
    }
  },
  "files": [
    "bin/cefari.js",
    "config/index.cjs",
    "config/index.d.ts",
    "config/index.mjs",
    "README.md"
  ],
  "optionalDependencies": {
    "@cefari/cli-darwin-arm64": "0.0.0",
    "@cefari/cli-darwin-x64": "0.0.0",
    "@cefari/cli-linux-x64": "0.0.0",
    "@cefari/cli-win32-x64": "0.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
